{%- comment -%} Featured collection grid. Pulls a real collection's products. {%- endcomment -%}
{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}
<section class="section {% if section.settings.contrast %}band--contrast{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__title">
        {%- if section.settings.eyebrow != blank -%}<span class="label">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="display display--l">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if coll != empty and section.settings.show_view_all -%}
        <a class="link link--arrow" href="{{ coll.url }}">{{ section.settings.view_all_label | default: 'Ver todo' | escape }}</a>
      {%- endif -%}
    </div>

    {%- if coll != empty and coll.products.size > 0 -%}
      <div class="product-grid product-grid--{{ section.settings.columns }} {% if section.settings.mobile_scroll %}scroller-mobile{% endif %}" data-grid>
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', card_product: product, position: forloop.index, reveal: true %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid product-grid--{{ section.settings.columns }}">
        {%- for i in (1..limit) -%}
          <article class="pcard"><div class="pcard__frame" style="--pad:125%">{{ 'product-' | append: i | placeholder_svg_tag: 'pcard__img' }}</div>
          <div class="pcard__meta"><h3 class="pcard__name">Producto de ejemplo</h3><span class="price"><span class="price__now">{{ 1900 | money }}</span></span></div></article>
        {%- endfor -%}
      </div>
      {%- if coll == empty -%}<p class="form-note" style="margin-top:1rem">Elige una colección en el editor del tema.</p>{%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Lo nuevo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Recién llegado" },
    { "type": "checkbox", "id": "contrast", "label": "Fondo oscuro", "default": false },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Productos a mostrar", "default": 4 },
    {
      "type": "select", "id": "columns", "label": "Columnas (escritorio)",
      "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ],
      "default": "4"
    },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Desplazamiento horizontal en móvil", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar “Ver todo”", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Texto de “Ver todo”", "default": "Ver la colección" }
  ],
  "presets": [ { "name": "Colección destacada" } ]
}
{% endschema %}
