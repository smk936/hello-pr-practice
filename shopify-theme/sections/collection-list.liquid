{%- comment -%} "Worlds" — a grid of collections, each an image tile linking to the collection. {%- endcomment -%}
<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head">
        <div class="section-head__title">
          {%- if section.settings.eyebrow != blank -%}<span class="label">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="display display--l">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="worlds">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <a class="world reveal" href="{{ coll.url | default: '#' }}" style="--i:{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width:768px) 33vw, 100vw', widths: '400,600,900', alt: block.settings.title | default: coll.title | escape }}
          {%- elsif coll.featured_image != blank -%}
            {{ coll.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width:768px) 33vw, 100vw', widths: '400,600,900', alt: coll.title | escape }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <span class="world__label">{{ block.settings.title | default: coll.title | default: 'Colección' | escape }}</span>
          {%- if coll != empty and block.settings.show_count -%}<span class="world__count">{{ coll.products_count }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista de colecciones",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Por dónde empezar" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tres formas de vestir la temporada" }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional; si no, usa la de la colección)" },
        { "type": "text", "id": "title", "label": "Título (opcional)" },
        { "type": "checkbox", "id": "show_count", "label": "Mostrar nº de productos", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lista de colecciones",
      "blocks": [ { "type": "world" }, { "type": "world" }, { "type": "world" } ]
    }
  ]
}
{% endschema %}
