{%- comment -%} Contact page with native contact form + optional page content. {%- endcomment -%}
<div class="section section--tight">
  <div class="page-width">
    <div class="editorial" style="align-items:start">
      <div class="stack">
        <span class="label">{{ section.settings.eyebrow | default: 'Escríbenos' | escape }}</span>
        <h1 class="page-hero__title">{{ page.title | default: section.settings.heading | escape }}</h1>
        {%- if page.content != blank -%}<div class="rte measure">{{ page.content }}</div>{%- endif -%}
        {%- if section.settings.email != blank -%}<p><a class="link" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>{%- endif -%}
        {%- if section.settings.hours != blank -%}<p class="form-note">{{ section.settings.hours | escape }}</p>{%- endif -%}
      </div>

      <div>
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success">Gracias. Te respondemos el mismo día laborable.</p>
          {%- elsif form.errors -%}
            <div class="errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="stack" style="max-width:520px">
            <div class="field"><label class="field__label" for="contact-name">Nombre</label><input class="input" id="contact-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></div>
            <div class="field"><label class="field__label" for="contact-email">Correo</label><input class="input" type="email" id="contact-email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required></div>
            <div class="field"><label class="field__label" for="contact-phone">Teléfono (opcional)</label><input class="input" type="tel" id="contact-phone" name="contact[phone]" value="{{ form.phone }}"></div>
            <div class="field"><label class="field__label" for="contact-body">Mensaje</label><textarea class="input" id="contact-body" name="contact[body]" required>{{ form.body }}</textarea></div>
            <button type="submit" class="btn">Enviar</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contacto",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Escríbenos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hablemos" },
    { "type": "text", "id": "email", "label": "Correo visible" },
    { "type": "text", "id": "hours", "label": "Horario de atención", "default": "L–V · 9:00–18:00" }
  ]
}
{% endschema %}
