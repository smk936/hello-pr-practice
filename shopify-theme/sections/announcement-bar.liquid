{%- comment -%} Top announcement bar. Blocks = individual messages. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announcement{% if section.settings.marquee %} announcement--marquee{% endif %}">
    <div class="announcement__inner page-width">
      <div class="announcement__track">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </span>
        {%- endfor -%}
        {%- if section.settings.marquee -%}
          {%- comment -%} duplicate track for seamless loop {%- endcomment -%}
          {%- for block in section.blocks -%}
            <span aria-hidden="true">{{ block.settings.text | escape }}</span>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "marquee", "label": "Desplazamiento continuo", "default": false }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Envío en 24–48 h · Devoluciones sencillas" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [
        { "type": "message", "settings": { "text": "Envío en 24–48 h" } },
        { "type": "message", "settings": { "text": "Devoluciones en 30 días" } }
      ]
    }
  ]
}
{% endschema %}
