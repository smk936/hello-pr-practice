{%- comment -%} Customer account dashboard: recent orders + details. {%- endcomment -%}
<div class="account page-width">
  <div class="section-head">
    <div class="section-head__title">
      <span class="label">{{ 'customer.account.title' | t }}</span>
      <h1 class="display display--l">Hola, {{ customer.first_name | default: customer.email | escape }}</h1>
    </div>
    <a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
  </div>

  <div class="account__grid">
    <nav class="account__nav">
      <a href="{{ routes.account_url }}" aria-current="page">{{ 'customer.account.orders' | t }}</a>
      <a href="{{ routes.account_addresses_url }}">Direcciones ({{ customer.addresses_count }})</a>
      <a href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
    </nav>

    <div class="stack">
      <h2 class="display display--m">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="orders-table">
            <thead>
              <tr><th>Pedido</th><th>Fecha</th><th>Estado del pago</th><th>Envío</th><th>Total</th></tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_net_amount | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
          {%- if paginate.pages > 1 -%}
            <nav class="pagination">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>
                {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <p class="form-note">Aún no tienes pedidos.</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">Empezar a mirar</a>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Cuenta", "settings": [] }
{% endschema %}
