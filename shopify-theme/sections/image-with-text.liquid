{%- comment -%} Editorial image + text, alternating sides. {%- endcomment -%}
<section class="section {% if section.settings.contrast %}band--contrast{% endif %}">
  <div class="page-width">
    <div class="editorial {% if section.settings.layout == 'text_first' %}editorial--reverse{% endif %}">
      <div class="editorial__media reveal">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width:768px) 50vw, 100vw', widths: '600,900,1200', alt: section.settings.heading | escape }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="editorial__body reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="label">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="display display--m">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="rte measure">{{ section.settings.body }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div><a class="btn {% if section.settings.contrast %}btn--secondary{% endif %}" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen con texto",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    {
      "type": "select", "id": "layout", "label": "Disposición",
      "options": [ { "value": "image_first", "label": "Imagen a la izquierda" }, { "value": "text_first", "label": "Imagen a la derecha" } ],
      "default": "image_first"
    },
    { "type": "checkbox", "id": "contrast", "label": "Fondo oscuro", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "El tejido" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lana que respira, no que pica" },
    { "type": "richtext", "id": "body", "label": "Texto", "default": "<p>Trabajamos con hilaturas que ya conoces por su tacto. Añade aquí el origen real del tejido cuando lo tengas confirmado.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón" },
    { "type": "url", "id": "button_link", "label": "Enlace" }
  ],
  "presets": [ { "name": "Imagen con texto" } ]
}
{% endschema %}
