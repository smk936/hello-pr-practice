{%- comment -%}
  Product page. Native product / variants / options / media / metafields.
  Add-to-cart is a real {% form 'product' %}; JS enhances (variant switching, AJAX).
  Works without JS (submits the form, reloads with ?variant=).
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<section class="section section--tight" data-product-root>
  <div class="page-width">
    <div class="product">
      {%- comment -%} ---------------- MEDIA ---------------- {%- endcomment -%}
      <div class="product__media">
        <div class="product__gallery">
          <div class="product__gallery-main" data-gallery-main>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div class="product__slide" data-media-id="{{ media.id }}"{% unless media.id == current_variant.featured_media.id or forloop.first and current_variant.featured_media == nil %} hidden{% endunless %}>
                  {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      {{ media | image_url: width: 1400 | image_tag: loading: img_loading, sizes: '(min-width: 1024px) 55vw, 100vw', widths: '400,600,800,1200,1400', alt: media.alt | default: product.title | escape }}
                    {%- when 'video' -%}
                      {{ media | video_tag: controls: true, image_size: '1200x' }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag }}
                    {%- when 'model' -%}
                      {{ media | model_viewer_tag }}
                    {%- else -%}
                      {{ media | media_tag }}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="product__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="product__thumbs" role="list">
              {%- for media in product.media -%}
                <button type="button" class="product__thumb" data-thumb="{{ media.id }}" aria-current="{% if media.id == current_variant.featured_media.id %}true{% else %}false{% endif %}" aria-label="Ver imagen {{ forloop.index }}">
                  {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', alt: media.alt | default: product.title | escape }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ---------------- INFO ---------------- {%- endcomment -%}
      <div class="product__info">
        {%- if product.vendor != blank and section.settings.show_vendor -%}
          <a class="product__vendor" href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a>
        {%- endif -%}
        <h1 class="product__title">{{ product.title | escape }}</h1>

        <div class="product__price" data-price>
          {% render 'price', price_variant: current_variant %}
        </div>

        {%- comment -%} Variant data for JS {%- endcomment -%}
        <script type="application/json" data-variant-json>
          [
            {%- for v in product.variants -%}
              {%- capture ph -%}{% render 'price', price_variant: v %}{%- endcapture -%}
              {"id": {{ v.id }},"available": {{ v.available }},"price": {{ v.price }},"options": {{ v.options | json }},"featured_media": {% if v.featured_media %}{"id": {{ v.featured_media.id }}}{% else %}null{% endif %},"price_html": {{ ph | strip | json }}}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>

        {%- form 'product', product, id: 'product-form', class: 'product__form', novalidate: 'novalidate', data-product-form: '', data-buy-anchor: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="product__options">
              {%- for option in product.options_with_values -%}
                {%- assign oname = option.name | downcase -%}
                {%- assign is_color = false -%}
                {%- if oname contains 'color' or oname contains 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
                {%- assign is_size = false -%}
                {%- if oname contains 'talla' or oname contains 'size' -%}{%- assign is_size = true -%}{%- endif -%}
                <div class="option" data-option-index="{{ forloop.index0 }}">
                  <div class="option__head">
                    <span class="option__name">{{ option.name | escape }}</span>
                    {%- if is_size and section.settings.size_guide_page != blank -%}
                      <a class="option__value link" href="{{ pages[section.settings.size_guide_page].url }}" data-overlay-open="#size-guide">{{ 'products.product.size_guide' | t }}</a>
                    {%- else -%}
                      <span class="option__value" data-option-selected>{{ option.selected_value | escape }}</span>
                    {%- endif -%}
                  </div>

                  {%- if is_color -%}
                    <div class="swatches">
                      {%- for value in option.values -%}
                        <label class="swatch" title="{{ value | escape }}" style="--sw: {% if value.swatch.color %}{{ value.swatch.color }}{% else %}var(--color-border){% endif %}">
                          <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" data-label="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                          {%- if value.swatch.image -%}<span style="background-image:url({{ value.swatch.image | image_url: width: 60 }})"></span>{%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- elsif is_size -%}
                    <div class="sizes">
                      {%- for value in option.values -%}
                        <label class="size">
                          <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" data-label="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                          <span class="size__label">{{ value | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="sizes">
                      {%- for value in option.values -%}
                        <label class="size">
                          <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" data-label="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                          <span class="size__label">{{ value | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="product__buy">
            {%- if section.settings.show_quantity -%}
              <div class="option">
                <span class="option__name">{{ 'products.product.quantity' | t }}</span>
                <div class="qty">
                  <button type="button" class="qty__btn" data-qty-adjust="-1" aria-label="Menos">{% render 'icon', icon: 'minus' %}</button>
                  <input class="qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" class="qty__btn" data-qty-adjust="1" aria-label="Más">{% render 'icon', icon: 'plus' %}</button>
                </div>
              </div>
            {%- endif -%}

            <button type="submit" name="add" class="btn btn--block" data-add-btn {% unless current_variant.available %}aria-disabled="true"{% endunless %}>
              <span class="btn__swap" data-default="{{ 'products.product.add_to_cart' | t }}" data-soldout="{{ 'products.product.sold_out' | t }}" data-unavailable="{{ 'products.product.unavailable' | t }}">
                {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
              </span>
            </button>

            {%- if section.settings.show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>
        {%- endform -%}

        {%- comment -%} ---------------- BLOCKS (accordions, assurances, text) ---------------- {%- endcomment -%}
        {%- if product.description != blank and section.settings.show_description_top -%}
          <div class="product__desc rte">{{ product.description }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="accordions">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'collapsible' -%}
                  {%- liquid
                    assign content = block.settings.content
                    if block.settings.metafield_namespace != blank and block.settings.metafield_key != blank
                      assign mf = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
                      if mf != blank
                        assign content = mf | metafield_tag
                      endif
                    endif
                  -%}
                  <details class="accordion"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                    <summary class="accordion__summary">{{ block.settings.heading | escape }} {% render 'icon', icon: 'plus' %}</summary>
                    <div class="accordion__body{% if content == blank %} accordion__body--empty{% endif %}"{% if content == blank %} data-empty{% endif %}>
                      {%- if content != blank -%}{{ content }}{%- else -%}{{ block.settings.placeholder | escape }}{%- endif -%}
                    </div>
                  </details>
                {%- when 'assurances' -%}
                  <div class="assurances" {{ block.shopify_attributes }}>
                    {%- if block.settings.a1_title != blank -%}<div class="assurance"><span class="assurance__t">{{ block.settings.a1_title | escape }}</span><span class="assurance__d">{{ block.settings.a1_text | escape }}</span></div>{%- endif -%}
                    {%- if block.settings.a2_title != blank -%}<div class="assurance"><span class="assurance__t">{{ block.settings.a2_title | escape }}</span><span class="assurance__d">{{ block.settings.a2_text | escape }}</span></div>{%- endif -%}
                    {%- if block.settings.a3_title != blank -%}<div class="assurance"><span class="assurance__t">{{ block.settings.a3_title | escape }}</span><span class="assurance__d">{{ block.settings.a3_text | escape }}</span></div>{%- endif -%}
                  </div>
                {%- when 'text' -%}
                  <div class="product__extra rte measure" {{ block.shopify_attributes }}>{{ block.settings.body }}</div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ---------------- STICKY BUY (mobile) ---------------- {%- endcomment -%}
  <div class="sticky-buy" data-sticky-buy>
    <div class="sticky-buy__info">
      <span class="sticky-buy__name">{{ product.title | escape }}</span>
      <span class="sticky-buy__price" data-sticky-price>{% render 'price', price_variant: current_variant %}</span>
    </div>
    <button type="button" class="btn" data-sticky-add>{{ 'products.product.add_to_cart' | t }}</button>
  </div>
</section>

{%- comment -%} Structured data for SEO {%- endcomment -%}
<script type="application/ld+json">
{{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca (vendor)", "default": false },
    { "type": "checkbox", "id": "show_quantity", "label": "Selector de cantidad", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Botones de pago dinámico", "default": true },
    { "type": "checkbox", "id": "show_description_top", "label": "Descripción bajo el precio", "default": true },
    { "type": "page", "id": "size_guide_page", "label": "Página de guía de tallas (opcional)" }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Detalles" },
        { "type": "checkbox", "id": "open", "label": "Abierto por defecto", "default": false },
        { "type": "richtext", "id": "content", "label": "Contenido (si no usas metacampo)" },
        { "type": "text", "id": "metafield_namespace", "label": "Metacampo — namespace", "info": "Ej.: custom" },
        { "type": "text", "id": "metafield_key", "label": "Metacampo — key", "info": "Ej.: material" },
        { "type": "text", "id": "placeholder", "label": "Texto si está vacío", "default": "Añade esta información desde Producto → Metacampos." }
      ]
    },
    {
      "type": "assurances",
      "name": "Garantías",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Muestra solo lo que sea verdad en tu tienda." },
        { "type": "text", "id": "a1_title", "label": "Título 1", "default": "Envío 24–48 h" },
        { "type": "text", "id": "a1_text", "label": "Texto 1", "default": "Pedidos antes de las 14 h." },
        { "type": "text", "id": "a2_title", "label": "Título 2", "default": "Devolución 30 días" },
        { "type": "text", "id": "a2_text", "label": "Texto 2", "default": "Sin preguntas." },
        { "type": "text", "id": "a3_title", "label": "Título 3", "default": "Pago seguro" },
        { "type": "text", "id": "a3_text", "label": "Texto 3", "default": "Cifrado en toda la compra." }
      ]
    },
    {
      "type": "text",
      "name": "Texto libre",
      "settings": [
        { "type": "richtext", "id": "body", "label": "Texto" }
      ]
    }
  ]
}
{% endschema %}
