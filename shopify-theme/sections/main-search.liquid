{%- comment -%} Search results. Native Shopify search over products, articles, pages. {%- endcomment -%}
<div class="section section--tight">
  <div class="page-width">
    <div class="collection-hero">
      <span class="label">Búsqueda</span>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width:640px">
        {% render 'icon', icon: 'search' %}
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="visually-hidden">{{ 'general.search.search' | t }}</button>
      </form>
      {%- if search.performed -%}
        <p class="collection-hero__desc">
          {%- if search.results_count > 0 -%}
            {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
          {%- else -%}
            {{ 'general.search.no_results' | t }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed and search.results_count > 0 -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        <div class="product-grid product-grid--{{ section.settings.columns }} search-results-grid" data-grid>
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item, position: forloop.index, reveal: true %}
            {%- else -%}
              <article class="article-card reveal">
                {%- if item.image != blank -%}
                  <a class="article-card__media" href="{{ item.url }}">{{ item.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: item.title | escape }}</a>
                {%- endif -%}
                <span class="article-card__meta">{{ item.object_type }}</span>
                <a href="{{ item.url }}"><h3 class="article-card__title">{{ item.title | escape }}</h3></a>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation" aria-label="Paginación">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Anterior">{% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>
              {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Siguiente">{% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- elsif search.performed -%}
      <div class="cart-empty">
        <p class="display display--m">{{ 'general.search.no_results' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">Ver todo</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Búsqueda",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "results_per_page", "min": 8, "max": 48, "step": 4, "label": "Resultados por página", "default": 24 },
    {
      "type": "select", "id": "columns", "label": "Columnas",
      "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ],
      "default": "4"
    }
  ]
}
{% endschema %}
