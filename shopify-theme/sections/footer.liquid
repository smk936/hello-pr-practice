{%- comment -%} Footer: wordmark, link columns, newsletter, social, payments. {%- endcomment -%}
<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        {%- if section.settings.wordmark != blank -%}
          <p class="footer__wordmark">{{ section.settings.wordmark | escape }}</p>
        {%- else -%}
          <p class="footer__wordmark">{{ shop.name | escape }}</p>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="measure">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_pinterest != blank -%}
          <div class="footer__social">
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" class="link">Instagram</a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" class="link">TikTok</a>{%- endif -%}
            {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" class="link">Pinterest</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<span class="label">{{ block.settings.heading | escape }}</span>{%- endif -%}
              {%- for link in linklists[block.settings.menu].links -%}
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- endfor -%}
            </div>
          {%- when 'text' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<span class="label">{{ block.settings.heading | escape }}</span>{%- endif -%}
              <div class="rte">{{ block.settings.body }}</div>
            </div>
          {%- when 'newsletter' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<span class="label">{{ block.settings.heading | escape }}</span>{%- endif -%}
              {%- if block.settings.body != blank -%}<p class="measure">{{ block.settings.body | escape }}</p>{%- endif -%}
              {%- form 'customer', class: 'newsletter__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input type="hidden" name="contact[accepts_marketing]" value="true">
                <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.label' | t }}" aria-label="{{ 'general.newsletter.label' | t }}" required>
                <button type="submit" class="link link--arrow">{{ 'general.newsletter.button' | t }}</button>
                {%- if form.posted_successfully? -%}
                  <p class="newsletter__success">{{ 'general.newsletter.success' | t }}</p>
                {%- elsif form.errors -%}
                  <p class="form-error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.rights | escape }}</span>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__pay">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.locale_selector and shop.published_locales.size > 1 -%}
        {%- form 'localization', class: 'footer__locale' -%}
          <select name="locale_code" onchange="this.form.submit()" aria-label="Idioma" class="select-native">
            {%- for loc in shop.published_locales -%}
              <option value="{{ loc.iso_code }}"{% if loc.iso_code == request.locale.iso_code %} selected{% endif %}>{{ loc.endonym_name }}</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Marca (grande)", "default": "CENIT" },
    { "type": "text", "id": "tagline", "label": "Frase de marca", "default": "Ropa de temporada, hecha para durar más de una." },
    { "type": "text", "id": "rights", "label": "Aviso de derechos", "default": "Todos los derechos reservados." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar iconos de pago", "default": true },
    { "type": "checkbox", "id": "locale_selector", "label": "Selector de idioma", "default": false }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de menú",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Tienda" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Columna de texto",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Ayuda" },
        { "type": "richtext", "id": "body", "label": "Texto", "default": "<p>Escríbenos y te respondemos el mismo día laborable.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Boletín",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Una carta al mes" },
        { "type": "text", "id": "body", "label": "Texto", "default": "Sin ruido. Solo lo nuevo y algo que leer." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pie de página",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Tienda" } },
        { "type": "text", "settings": { "heading": "Ayuda" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
