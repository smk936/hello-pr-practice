{%- comment -%} Storefront password page content. {%- endcomment -%}
<div class="page-width" style="min-height:80vh;display:grid;place-content:center;text-align:center;gap:1.4rem;padding-block:4rem">
  {%- if section.settings.logo != blank -%}
    {{ section.settings.logo | image_url: width: 400 | image_tag: widths: '200,400', sizes: '200px', style: 'margin-inline:auto;max-width:200px;height:auto', alt: shop.name | escape }}
  {%- else -%}
    <p class="display display--l">{{ shop.name | escape }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}<h1 class="display display--m">{{ section.settings.heading | escape }}</h1>{%- endif -%}
  {%- if shop.password_message != blank -%}<div class="lede" style="margin-inline:auto">{{ shop.password_message }}</div>{%- endif -%}

  {%- form 'storefront_password', class: 'newsletter__form', style: 'max-width:420px;margin-inline:auto' -%}
    <input type="password" name="password" placeholder="Contraseña de la tienda" aria-label="Contraseña" required>
    <button type="submit" class="link link--arrow">Entrar</button>
    {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.password }} {{ form.errors.messages.password }}</p>{%- endif -%}
  {%- endform -%}

  <p class="form-note">¿Eres la tienda? <a href="/admin" class="link">Inicia sesión</a></p>
</div>

{% schema %}
{
  "name": "Contraseña",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Estamos preparando algo" }
  ]
}
{% endschema %}
