{%- comment -%}
  Product recommendations. Uses Shopify's native recommendations engine.
  Renders on the product template; empty elsewhere.
{%- endcomment -%}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <section class="section">
    <div class="page-width">
      <div class="section-head">
        <div class="section-head__title">
          <h2 class="display display--m">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <div class="product-grid product-grid--{{ section.settings.columns }} scroller-mobile">
        {%- for product in recommendations.products limit: section.settings.products_to_show -%}
          {% render 'product-card', card_product: product, position: forloop.index, reveal: true %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section"><div class="page-width"><p class="form-note">Las recomendaciones aparecen aquí en una página de producto real.</p></div></section>
{%- endif -%}

{% schema %}
{
  "name": "Recomendaciones",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Combina bien con" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "label": "Productos", "default": 4 },
    {
      "type": "select", "id": "columns", "label": "Columnas",
      "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ],
      "default": "4"
    }
  ]
}
{% endschema %}
