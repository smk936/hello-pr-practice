{%- comment -%} Reset password. {%- endcomment -%}
<div class="auth">
  <h1 class="auth__title">Nueva contraseña</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="stack">
      <div class="field">
        <label class="field__label" for="reset-password">Contraseña</label>
        <input class="input" type="password" id="reset-password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="reset-confirm">Repite la contraseña</label>
        <input class="input" type="password" id="reset-confirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--block">Guardar contraseña</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Restablecer contraseña", "settings": [] }
{% endschema %}
