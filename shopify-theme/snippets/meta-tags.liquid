{%- comment -%} Open Graph + Twitter, from native Shopify objects {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
{%- liquid
  assign og_image = nil
  if request.page_type == 'product' and product != blank and product.featured_media
    assign og_image = product.featured_media.preview_image
  elsif request.page_type == 'article' and article != blank and article.image
    assign og_image = article.image
  elsif settings.logo != blank
    assign og_image = settings.logo
  endif
-%}
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta name="twitter:card" content="summary_large_image">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
<meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
