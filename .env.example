# ─────────────────────────────────────────────────────────────
# CENIT storefront — environment variables
#
# 1. Copy this file to `.env.local`  →  cp .env.example .env.local
# 2. Fill in the values you need (see README → "Variables de entorno").
# 3. NEVER commit `.env.local`. It is git-ignored.
#
# The app runs fully with NO variables set (local/dev mode). Each block
# below activates a real integration when you fill it in.
# ─────────────────────────────────────────────────────────────

# ── Site (read by the app today) ─────────────────────────────
# Absolute public URL. Used for canonical URLs, Open Graph and sitemap.xml.
# Local: http://localhost:3000 · Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Commerce backend (read by the app today) ─────────────────
# "local"   → built-in seed catalog in src/lib/commerce/data (default, no setup)
# "shopify" → Shopify Storefront API (requires the two SHOPIFY_ vars below)
COMMERCE_PROVIDER=local

# ── Shopify (read when COMMERCE_PROVIDER=shopify) ─────────────
# Store domain, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API public access token (Admin → Apps → Develop apps → Storefront API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ── Payments / Stripe (read when set) ────────────────────────
# With STRIPE_SECRET_KEY set, /api/checkout switches off dev mode.
# NOTE: the real PaymentIntent is a documented TODO — see README → "Pagos".
STRIPE_SECRET_KEY=
# Needed to finish the Stripe integration (not read yet):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Transactional email / newsletter (EMAIL_PROVIDER read when set) ──
# With EMAIL_PROVIDER set, /api/contact and /api/newsletter switch off dev logging.
# Wire your provider (Resend, Postmark, Klaviyo…) in those route handlers.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=hola@your-domain.com

# ── Auth (reserved — needed only for real customer accounts) ──
# The current auth is a browser-only DEV adapter. To move to a real backend
# (Shopify Customer Accounts or your own), you will add a signing secret here.
AUTH_SECRET=
