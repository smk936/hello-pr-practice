# ─────────────────────────────────────────────────────────────
# CENIT storefront — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# The app runs fully in "local/dev" mode with NO secrets set.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Commerce backend ──────────────────────────────────────────
# "local"  → seed catalog in src/lib/commerce/data (default, no setup)
# "shopify" → Shopify Storefront API (requires the two vars below)
COMMERCE_PROVIDER=local
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ── Payments ──────────────────────────────────────────────────
# Leave unset → checkout runs in DEV mode: it records a real order in the
# order store and shows a confirmation clearly marked as a test order.
# Set these → checkout uses Stripe.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Auth ──────────────────────────────────────────────────────
# "local"  → dev sessions (httpOnly cookie, in-memory/seed users)
# "shopify" → Shopify Customer Accounts (configure later)
AUTH_PROVIDER=local
# AUTH_SECRET=            # required in production for signing session cookies

# ── Transactional email / contact / newsletter ────────────────
# Leave unset → messages are logged server-side and the UI confirms receipt.
# Set to wire a real provider (Resend, Postmark, Klaviyo, …).
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=hola@cenit.example
